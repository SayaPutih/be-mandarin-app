generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  TEACHER
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  name         String?
  password     String
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  role         Role               @default(USER)
  attempts     FlashCardAttempt[]
  memoryStates WordMemoryState[]
}

model MandarinWord {
  id                String             @id @default(uuid())
  simplified        String             @unique
  pinyin            String
  pos               String?
  hskLevel          Int
  radical           String?
  lexicalDifficulty Float?
  createdAt         DateTime           @default(now())
  attempts          FlashCardAttempt[]
  meanings          MandarinMeaning[]
  memoryStates      WordMemoryState[]

  @@index([hskLevel])
}

model MandarinMeaning {
  id      String       @id @default(uuid())
  wordId  String
  meaning String
  word    MandarinWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
}

model FlashCardAttempt {
  id                  String                @id @default(uuid())
  userId              String
  wordId              String
  totalReviews        Int                   @default(0)
  correctReviews      Int                   @default(0)
  averageAnswerTimeMs Float?
  lastAnswerCorrect   Boolean?
  lastReviewedAt      DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User                  @relation(fields: [userId], references: [id])
  word                MandarinWord          @relation(fields: [wordId], references: [id])
  logs                FlashCardAttemptLog[]

  @@unique([userId, wordId])
  @@index([userId])
  @@index([wordId])
}

model FlashCardAttemptLog {
  id                 String           @id @default(uuid())
  flashcardAttemptId String
  isCorrect          Boolean
  answerTimeMs       Int?
  createdAt          DateTime         @default(now())
  flash              FlashCardAttempt @relation(fields: [flashcardAttemptId], references: [id])

  @@index([flashcardAttemptId])
}

model WordMemoryState {
  id                  String       @id @default(uuid())
  userId              String
  wordId              String
  reviewCount         Int          @default(0)
  rHistory            String?
  tHistory            String?
  pHistory            String?
  lastReviewAt        DateTime?
  lastAnswerTimeMs    Int?
  averageAnswerTimeMs Float?
  stability           Float?
  wordDifficulty      Float?
  predictedRecall     Float?
  predictedHalfLife   Float?
  nextReviewAt        DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                User         @relation(fields: [userId], references: [id])
  word                MandarinWord @relation(fields: [wordId], references: [id])

  @@unique([userId, wordId])
  @@index([userId])
  @@index([wordId])
}

model SystemConfig {
  id                String    @id @default(uuid()) @db.Uuid
  currentReviewDate DateTime? @db.Timestamp(6)
}
